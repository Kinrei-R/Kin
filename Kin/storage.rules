rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /artworks/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && file == request.auth.uid + '.jpg'
        && request.resource.size < 1 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }
  }
}
